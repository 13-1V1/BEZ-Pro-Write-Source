{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BEZ Pro Write",
  "version": "1.5.0",
  "identifier": "com.brennanmeyer.bezprowrite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BEZ Pro Write",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#14161a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/voice-pack/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "windows": {
      "wix": {
        "template": "wix/main.wxs"
      }
    },
    "resources": {
      "../voice-pack/": "voice-pack/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Brennan Meyer",
    "shortDescription": "Guided professional writing with the 7 C's",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
